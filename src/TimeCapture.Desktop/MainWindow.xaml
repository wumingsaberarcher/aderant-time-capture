<Window x:Class="TimeCapture.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time capture desktop (talks to the server)"
        Width="440" Height="280"
        AutomationProperties.AutomationId="time-capture-window">
  <!-- Injecting tests = giving the control a stable name the test can find.
       Web uses data-testid. Desktop WPF uses AutomationId. Same job. -->
  <StackPanel Margin="16">
    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
               Text="This window is the desktop client. Save still goes to the same /api/entries server as the webpage." />
    <Label Content="Comment — what exactly occurred" Target="{Binding ElementName=Narrative}" />
    <TextBox x:Name="Narrative"
             AutomationProperties.AutomationId="narrative"
             Height="64"
             TextWrapping="Wrap"
             AcceptsReturn="True" />
    <Button Margin="0,12,0,8"
            Padding="8"
            Content="Save time entry"
            AutomationProperties.AutomationId="save-entry"
            Click="Save_Click" />
    <TextBlock x:Name="TodaysEntries"
               AutomationProperties.AutomationId="todays-entries"
               Text="No entries yet." />
  </StackPanel>
</Window>
